##############################################################################
# GTAI — Global Travel AI
# Example environment file.
#
# V2.8-F requires NO environment variable by default. The application builds,
# starts and runs with this file absent, and every line below is a comment —
# nothing here is active, and nothing here is read by the application.
#
# CURRENT FACTS (V2.8-D)
#   - the canonical public origin is a literal in
#     `src/config/public-company-profile.ts`, not an environment variable: a
#     canonical URL that depends on deployment config silently points at a
#     preview host
#   - no external or live travel provider is connected
#   - the local deterministic demonstration provider needs no credential
#   - no provider key is required, and none exists in this repository
#   - no key is exposed to the browser
#   - there is no server-side account store and no database
#   - recent location identifiers use tab-scoped browser `sessionStorage`;
#     nothing about them is server-side
#   - the placeholders below remain commented, empty and unread
#
# Everything below documents the intended *shape* of a later integration so
# nobody invents an ad-hoc convention. Copy this file to `.env.local` only when
# a variable is actually needed.
#
# RULES
#   - never commit `.env.local` or any file containing a real value
#   - never place a secret in a `NEXT_PUBLIC_*` variable: those are inlined
#     into the browser bundle and are readable by anyone
#   - no credential in this repository is real, and none is required
##############################################################################

# --- Affiliate / provider integration (V2.8-B and later) --------------------
# GTAI connects to NO provider today. These names document the intended shape
# of a future integration.
#
# Each provider would be reached through an approved affiliate programme,
# official API or licensed feed — never by scraping.

# Affiliate network account identifier (public, non-secret).
# NEXT_PUBLIC_AFFILIATE_PARTNER_ID=

# Server-side credential for an approved flight provider adapter.
# FLIGHT_PROVIDER_API_KEY=

# Future server-only Duffel test/live access token. Not required in V2.8-D;
# it also remains optional and inactive by default in V2.8-F.
# Leave empty. Never expose this as a NEXT_PUBLIC_ variable.
# DUFFEL_ACCESS_TOKEN=

# Future local/Vercel Preview manual-test directive. Absent/off by default,
# ignored in Production, and never exposed as a NEXT_PUBLIC_ variable.
# DUFFEL_MANUAL_TEST_ENABLED=

# Server-side credential for an approved accommodation provider adapter.
# STAY_PROVIDER_API_KEY=

# Server-side credential for an approved car rental provider adapter.
# CAR_PROVIDER_API_KEY=

# Base URL of the affiliate redirect service that would stamp and log outbound
# clicks. Not implemented; no outbound redirect exists in this release.
# AFFILIATE_REDIRECT_BASE_URL=

# --- Structured AI interview (later release) --------------------------------
# No AI model, agent runtime or model SDK exists today. These are placeholders
# for the eventual server-side interview orchestrator.

# Model provider credential. Server-side only — never expose to the browser.
# AI_PROVIDER_API_KEY=

# Model identifier used by the question orchestrator.
# AI_PLANNING_MODEL=

# --- Persistence (later release) --------------------------------------------
# GTAI stores nothing server-side today: no database, no session store, no
# traveller records, and no persistent application-level search audit log.

# DATABASE_URL=
