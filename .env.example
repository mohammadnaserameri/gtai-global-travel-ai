##############################################################################
# GTAI — Global Travel AI
# Example environment file.
#
# V1 (Global Foundation) requires NO environment variables at all. The
# application builds, starts and runs with this file absent.
#
# Everything below is a documented placeholder for a LATER release. Copy this
# file to `.env.local` only when a variable is actually needed.
#
# RULES
#   - never commit `.env.local` or any file containing a real value
#   - never place a secret in a `NEXT_PUBLIC_*` variable: those are inlined
#     into the browser bundle and are readable by anyone
#   - no credential in this repository is real, and none is required
##############################################################################

# --- Application ------------------------------------------------------------

# Absolute public origin, used to build canonical and alternate-language URLs.
# Unset in V1 because GTAI has no published domain yet.
# NEXT_PUBLIC_SITE_URL=

# --- Affiliate / provider integration (V2 and later) ------------------------
# GTAI connects to NO provider in V1. These names document the intended shape
# of a future integration so nobody invents an ad-hoc convention later.
#
# Each provider is reached through an approved affiliate programme, official
# API or licensed feed — never by scraping.

# Affiliate network account identifier (public, non-secret).
# NEXT_PUBLIC_AFFILIATE_PARTNER_ID=

# Server-side credential for an approved flight provider adapter.
# FLIGHT_PROVIDER_API_KEY=

# Server-side credential for an approved accommodation provider adapter.
# STAY_PROVIDER_API_KEY=

# Server-side credential for an approved car rental provider adapter.
# CAR_PROVIDER_API_KEY=

# Base URL of the affiliate redirect service that will stamp and log outbound
# clicks. Not implemented in V1.
# AFFILIATE_REDIRECT_BASE_URL=

# --- Structured AI interview (V2 and later) ---------------------------------
# No AI model, agent runtime or model SDK exists in V1. These are placeholders
# for the eventual server-side interview orchestrator.

# Model provider credential. Server-side only — never expose to the browser.
# AI_PROVIDER_API_KEY=

# Model identifier used by the question orchestrator.
# AI_PLANNING_MODEL=

# --- Persistence (V2 and later) ---------------------------------------------
# V1 stores nothing: no database, no session store, no traveller records.

# DATABASE_URL=
